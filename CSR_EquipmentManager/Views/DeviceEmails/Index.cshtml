@model IEnumerable<CSR_EquipmentManager.Models.DeviceEmail>

@{
    ViewBag.Title = "Danh sách Email Thiết Bị";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fas fa-envelope me-2"></i> Danh sách Email Thiết Bị</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary btn-lg">
        <i class="fas fa-plus"></i> Thêm Email Mới
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Thiết Bị (HS Code)</th>
                        <th>Email</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(item.Device?.HoSoCode)</strong><br />
                                <small class="text-muted">@(item.Device?.DeviceName)</small>
                            </td>
                            <td>
                                <i class="fas fa-envelope text-primary"></i>
                                @item.Email
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>