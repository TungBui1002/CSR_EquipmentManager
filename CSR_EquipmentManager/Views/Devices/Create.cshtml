@model CSR_EquipmentManager.Models.Device

@{
    ViewBag.Title = "Thêm Thiết Bị Mới";
}

<div class="card">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0"><i class="fas fa-plus me-2"></i> Thêm Thiết Bị Mới</h4>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Id)

            <div class="row">
                <div class="col-md-6">
                    @Html.Partial("_DeviceFormFields", Model)
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success btn-lg px-5">
                    <i class="fas fa-save"></i> Tạo Mới
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        }
    </div>
</div>