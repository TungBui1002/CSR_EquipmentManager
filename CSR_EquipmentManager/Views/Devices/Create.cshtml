@model CSR_EquipmentManager.Models.Device

@{
    ViewBag.Title = "Thêm Thiết Bị Mới";
}

<div class="card shadow-sm">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0"><i class="fas fa-plus me-2"></i> Thêm Thiết Bị Mới</h4>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @*@Html.HiddenFor(model => model.Id)*@

            <div class="row">
                <!-- Cột trái -->
                <div class="col-lg-6">
                    @Html.Partial("_DeviceFormFields", Model)
                </div>

                <div class="col-lg-6">
                    <div class="alert alert-info">
                        <h6><i class="fas fa-lightbulb"></i> @Lang.T("lable_Instruction")</h6>
                        <ul class="mb-0">
                            <li>@Lang.T("li_1")</li>
                            <li>@Lang.T("li_2")</li>
                            <li>@Lang.T("li_3")</li>
                        </ul>
                    </div>
                    <a href="@Url.Action("DownloadTemplate")" class="btn btn-outline-secondary btn-lg">
                        <i class="fas fa-download"></i> @Lang.T("btn_DownloadExcel")
                    </a>
                    <a href="@Url.Action("Import")" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-upload"></i> @Lang.T("btn_ImportExcel")
                    </a>
                </div>
            </div>

            <hr />

            <div class="text-end">
                <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg me-2">
                    <i class="fas fa-arrow-left"></i> Hủy
                </a>
                <button type="submit" class="btn btn-success btn-lg px-5">
                    <i class="fas fa-save"></i> Tạo Thiết Bị Mới
                </button>
            </div>
        }
    </div>
</div>