@*@model IEnumerable<CSR_EquipmentManager.Models.DeviceEmail>*@
@model IEnumerable<CSR_EquipmentManager.Models.ViewModel.DeviceEmailGroupVM>

@{
    ViewBag.Title = "Danh sách Email Thiết Bị";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fas fa-envelope me-2"></i> @Lang.T("Title_Email")</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary btn-lg">
        <i class="fas fa-plus"></i> @Lang.T("btn_AddEmail")
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Lang.T("device")</th>
                        <th>Email</th>
                        @*<th class="text-center">Thao Tác</th>*@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Device.HoSoCode - @item.Device.DeviceCode</strong><br />
                                <small class="text-muted">@item.Device.DeviceName</small>
                            </td>

                            <td>
                                @foreach (var mail in item.Emails)
                                {
                                    <span class="badge bg-light text-dark border me-2 mb-2 px-3 py-2 fs-6">
                                        @*<i class="fas fa-envelope text-primary me-1"></i>*@
                                        @mail.Email

                                        <!-- Edit -->
                                        <a href="@Url.Action("Edit", new { id = mail.Id })"
                                           class="ms-2 text-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <!-- Delete -->
                                        <a href="@Url.Action("Delete", new { id = mail.Id })"
                                           class="ms-1 text-danger"
                                           onclick="return confirm('Xóa email này?')">
                                            <i class="fas fa-times"></i>
                                        </a>
                                    </span>
                                }
                            </td>

                            @*<td class="text-center">
                                <a href="@Url.Action("Details", new { id = item.Device.Id })" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>*@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>