@model CSR_EquipmentManager.Models.Device

@{
    ViewBag.Title = "Sửa Thông Tin Thiết Bị";
}

<div class="card shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h4 class="mb-0"><i class="fas fa-edit me-2"></i> Sửa Thông Tin Thiết Bị</h4>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Id)

            <div class="row">
                <div class="col-lg-8">
                    @Html.Partial("_DeviceFormFields", Model)
                </div>
            </div>

            <hr />

            <div class="text-end">
                <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg me-2">
                    <i class="fas fa-arrow-left"></i> Hủy
                </a>
                <button type="submit" class="btn btn-warning btn-lg px-5">
                    <i class="fas fa-save"></i> Lưu Thay Đổi
                </button>
            </div>
        }
    </div>
</div>