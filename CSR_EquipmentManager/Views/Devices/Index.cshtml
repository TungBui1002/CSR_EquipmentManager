@model IEnumerable<CSR_EquipmentManager.Models.Device>

@{
    var title = ViewBag.Title ?? "Danh Sách Thiết Bị";
    var subtitle = ViewBag.Subtitle ?? "";
    var pageType = ViewBag.PageType ?? "all";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="fas fa-list"></i> Danh Sách Thiết Bị</h2>
    <a href="@Url.Action("Create")" class="btn btn-success btn-group-sm">
        <i class="fas fa-plus"></i> Thêm Thiết Bị Mới
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="devicesTable">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">Mã Hồ Sơ</th>
                        <th class="text-center">Xưởng</th>
                        <th class="text-center">Tòa Nhà - Tầng</th>
                        <th class="text-center">STT - Vị Trí</th>
                        <th>Mã Thiết Bị</th>
                        <th>Tên Thiết Bị</th>
                        <th>Model</th>
                        <th>Vị trí thiết bị</th>
                        <th class="text-center">Ngày Kiểm Định</th>
                        <th class="text-center">Ngày Kiểm Định Tiếp Theo</th>
                        <th>Hết hạn</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center"><strong>@item.HoSoCode</strong></td>
                            <td class="text-center">@item.Factory </td>
                            <td class="text-center">@item.Building - @item.Floor</td>
                            <td class="text-center">@item.STT - @item.PositionCode</td>
                            <td>@item.DeviceCode</td>
                            <td>@item.DeviceName</td>
                            <td>@item.ModelCode</td>
                            <td>@item.Location</td>
                            <td class="text-center">@(item.InspectionDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td class="text-center">@(item.NextInspectionDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>
                                @{
                                    int? daysLeft = null;
                                    if (item.NextInspectionDate.HasValue)
                                    {
                                        daysLeft = (item.NextInspectionDate.Value - DateTime.Now).Days;
                                    }
                                }

                                @if (!daysLeft.HasValue)
                                {
                                    <span class="badge bg-secondary">Không có</span>
                                }
                                else if (daysLeft < 0)
                                {
                                    <span class="badge bg-danger">Quá hạn @Math.Abs(daysLeft.Value) ngày</span>
                                }
                                else if (daysLeft <= 30)
                                {
                                    <span class="badge bg-warning text-dark">Còn @daysLeft ngày</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Còn @daysLeft ngày</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>