@model CSR_EquipmentManager.Models.DeviceEmail

@{
    ViewBag.Title = "Chi Tiết Email";
}

<div class="card">
    <div class="card-header bg-info text-white">
        <h4 class="mb-0"><i class="fas fa-envelope me-2"></i> Chi Tiết Email Thiết Bị</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Thiết Bị (HS Code):</dt>
            <dd class="col-sm-8 fw-bold">@(Model.Device?.HoSoCode)</dd>

            <dt class="col-sm-4">Tên Thiết Bị:</dt>
            <dd class="col-sm-8">@(Model.Device?.DeviceName)</dd>

            <dt class="col-sm-4">Email:</dt>
            <dd class="col-sm-8">
                <i class="fas fa-envelope text-primary"></i>
                <strong>@Model.Email</strong>
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-light">
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">
            <i class="fas fa-edit"></i> Sửa Email
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay Về Danh Sách
        </a>
    </div>
</div>