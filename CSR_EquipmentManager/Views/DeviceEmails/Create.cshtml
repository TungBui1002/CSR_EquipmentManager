@model CSR_EquipmentManager.Models.DeviceEmail

@{
    ViewBag.Title = "Thêm Email Mới";
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="fas fa-plus me-2"></i> Thêm Email Cho Thiết Bị</h4>
    </div>
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="row g-3">
                <div class="col-md-8">
                    @Html.LabelFor(m => m.DeviceId, "Chọn Thiết Bị", new { @class = "form-label fw-bold" })
                    @Html.DropDownList("DeviceId", null, "-- Chọn thiết bị --", new { @class = "form-control form-select" })
                    @Html.ValidationMessageFor(m => m.DeviceId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-8">
                    @Html.LabelFor(m => m.Email, "Địa Chỉ Email", new { @class = "form-label fw-bold" })
                    @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @class = "form-control", placeholder = "example@company.com" } })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="fas fa-save"></i> Thêm Email
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg">Hủy</a>
            </div>
        }
    </div>
</div>