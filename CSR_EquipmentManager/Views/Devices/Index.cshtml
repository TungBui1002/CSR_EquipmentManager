@model IEnumerable<CSR_EquipmentManager.Models.Device>

@{
    var title = ViewBag.Title ?? @Lang.T("Title_EquipmentList");
    var subtitle = ViewBag.Subtitle ?? "";
    var pageType = ViewBag.PageType ?? "all";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0 fw-bold">
            <i class="fas fa-list me-2"></i> @title
        </h2>
        @if (!string.IsNullOrEmpty(subtitle))
        {
            <p class="text-muted mb-0">@subtitle</p>
        }
    </div>

    <div>
        <a href="@Url.Action("Create")" class="btn btn-success btn-lg me-2">
            <i class="fas fa-plus"></i> @Lang.T("btn_add_device")
        </a>
        @if (pageType == "expiring")
        {
            <a href="@Url.Action("ExportExpiringSoonToExcel")" class="btn btn-primary btn-lg">
                <i class="fas fa-file-excel"></i> Export Excel
            </a>
        }
        else if (pageType == "expired")
        {
            <!-- Sau này làm export cho trang Quá hạn -->
            <a href="#" class="btn btn-primary btn-lg">
                <i class="fas fa-file-excel"></i> Export Excel
            </a>
        }
        else
        {
            <a href="@Url.Action("ExportToExcel")" class="btn btn-primary btn-lg">
                <i class="fas fa-file-excel"></i> Export Excel
            </a>
        }
    </div>
</div>

<!-- Ô tìm kiếm -->
<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" id="searchInput" class="form-control" placeholder="@Lang.T("label_search")">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="devicesTable">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">@Lang.T("ID_FileDevice")</th>
                        <th class="text-center">@Lang.T("Factory_Device")</th>
                        <th class="text-center">@Lang.T("Building_Floor_Device")</th>
                        <th class="text-center">@Lang.T("STT_PositionCode_Device")</th>
                        <th>@Lang.T("ID_Device")</th>
                        <th>@Lang.T("Name_Device")</th>
                        <th>@Lang.T("Model_Device")</th>
                        <th>@Lang.T("Positon_Device")</th>
                        <th class="text-center">@Lang.T("Inspection_Date_Device")</th>
                        <th class="text-center">@Lang.T("Next_Inspection_Date_Device")</th>
                        <th>@Lang.T("Expried_Device")</th>
                        <th class="text-center">@Lang.T("Col_Action")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center"><strong>@item.HoSoCode</strong></td>
                            <td class="text-center">@item.Factory</td>
                            <td class="text-center">@item.Building - @item.Floor</td>
                            <td class="text-center">@item.STT - @item.PositionCode</td>
                            <td>@item.DeviceCode</td>
                            <td>@item.DeviceName</td>
                            <td>@item.ModelCode</td>
                            <td>@item.Location</td>
                            <td class="text-center">@(item.InspectionDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td class="text-center">@(item.NextInspectionDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>
                                @{
                                    int? daysLeft = null;
                                    if (item.NextInspectionDate.HasValue)
                                    {
                                        daysLeft = (item.NextInspectionDate.Value - DateTime.Now).Days;
                                    }
                                }
                                @if (!daysLeft.HasValue)
                                {
                                    <span class="badge bg-secondary">Không có</span>
                                }
                                else if (daysLeft < 0)
                                {
                                    <span class="badge bg-danger">Quá hạn @Math.Abs(daysLeft.Value) ngày</span>
                                }
                                else if (daysLeft <= 30)
                                {
                                    <span class="badge bg-warning text-dark">Còn @daysLeft ngày</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Còn @daysLeft ngày</span>
                                }
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-info btn-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#searchInput").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#devicesTable tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}