@{
    ViewBag.Title = "Import Excel";
}

<h2>Import Excel</h2>

@using (Html.BeginForm("Import", "Devices", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div>
        <input type="file" name="excelFile" accept=".xlsx" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Upload</button>
}

@if (TempData["Error"] != null)
{
    <div style="color:red">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div style="color:green">@TempData["Success"]</div>
}