@model CSR_EquipmentManager.Models.ViewModel.DashboardVM

@{
    ViewBag.Title = "Dashboard";
}

@Html.AntiForgeryToken()
<div class="container-fluid py-4">
    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">
            <i class="fas fa-tachometer-alt me-1 text-primary"></i> Dashboard
        </h2>
    </div>

    <!-- 4 Cards thống kê -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <a href="@Url.Action("Index", "Devices")" style="text-decoration: none;">
                <div class="card shadow border-0 h-100">
                    <div class="card-body text-center">
                        <div class="text-primary mb-2">
                            <i class="fas fa-boxes-stacked fa-3x"></i>
                        </div>
                        <h5 class="card-title">@Lang.T("sum_devices")</h5>
                        <h2 class="fw-bold">@Model.TotalDevices</h2>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="@Url.Action("Index", "Devices")" style="text-decoration: none;">
                <div class="card shadow border-0 h-100 bg-success text-white">
                    <div class="card-body text-center">
                        <div class="mb-2">
                            <i class="fas fa-check-circle fa-3x"></i>
                        </div>
                        <h5 class="card-title">@Lang.T("good_devices")</h5>
                        <h2 class="fw-bold">@Model.ValidDevices</h2>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="@Url.Action("ExpiringSoon", "Devices",new { filter = "expiring" })" style="text-decoration: none;">
                <div class="card shadow border-0 h-100 bg-warning text-dark">
                    <div class="card-body text-center">
                        <div class="mb-2">
                            <i class="fas fa-clock fa-3x"></i>
                        </div>
                        <h5 class="card-title">@Lang.T("expiringsoon_devices") @Lang.T("date")</h5>
                        <h2 class="fw-bold">@Model.ExpiringSoonDevices</h2>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a href="@Url.Action("Expired", "Devices",new { filter = "expired" })" style="text-decoration: none;">
                <div class="card shadow border-0 h-100 bg-danger text-white">
                    <div class="card-body text-center">
                        <div class="mb-2">
                            <i class="fas fa-triangle-exclamation fa-3x"></i>
                        </div>
                        <h5 class="card-title">@Lang.T("expired_devices")</h5>
                        <h2 class="fw-bold">@Model.ExpiredDevices</h2>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- Biểu đồ -->
    <div class="row g-4">
        <!-- Bar Chart -->
        <div class="col-lg-6">
            <div class="card shadow border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">@Lang.T("dashboard_device_status")</h5>
                </div>
                <div class="card-body">
                    <canvas id="statusBarChart" height="200"></canvas>
                </div>
            </div>
        </div>

        <!-- Pie Chart -->
        <div class="col-lg-4">
            <div class="card shadow border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">@Lang.T("dashboard_device_ratio")</h5>
                </div>
                <div class="card-body">
                    <canvas id="statusPieChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12 text-center">
            <button id="btnSendEmail" class="btn btn-lg btn-danger">
                <i class="fas fa-envelope me-2"></i> @Lang.T("btn_send_emails")
            </button>
        </div>
    </div>

    <!-- Toast thông báo -->
    <div id="toastContainer"></div>

    <div class="card shadow border-0 mt-5">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="fas fa-comments me-2"></i> Trợ lý AI Tra Cứu</h5>
        </div>
        <div class="card-body">
            <div id="chat-content" style="height: 500px; overflow-y: auto; border: 1px solid #eee; padding: 10px; margin-bottom: 10px; background: #f9f9f9;">
                <p class="text-muted small italic">AI: Chào bạn! Tôi có thể giúp gì về dữ liệu thiết bị không?</p>
            </div>
            <div class="input-group">
                <input type="text" id="user-input" class="form-control" placeholder="Hỏi AI: Thiết bị nào sắp hết hạn?">
                <button class="btn btn-primary" id="btn-chat">Gửi</button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Toastr -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
    toastr.options = {
        "closeButton": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "timeOut": "6000"
    };

    $('#btnSendEmail').click(function () {
        var btn = $(this);
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang gửi email...');

        $.ajax({
            url: '@Url.Action("SendExpirationAlerts", "DashBoard")',
            type: 'POST',
            data: {
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                if (response.success) {
                    toastr.success(response.message, "Thành công");
                } else {
                    toastr.error(response.message, "Thất bại");
                }
            },
            error: function () {
                toastr.error("Có lỗi xảy ra khi kết nối server. Vui lòng thử lại.", "Lỗi");
            },
            complete: function () {
                btn.prop('disabled', false)
                   .html('<i class="fas fa-envelope me-2"></i> Gửi Email Cảnh Báo Thiết Bị Sắp Hết Hạn');
            }
        });
    });
    </script>

    <script>
        // Bar Chart
        const ctxBar = document.getElementById('statusBarChart').getContext('2d');
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Model.StatusLabels),
                datasets: [{
                    label: 'Số lượng',
                    data: @Html.Raw(Model.StatusData),
                    backgroundColor: @Html.Raw(Model.StatusColors),
                    borderColor: @Html.Raw(Model.StatusColors),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

        // Pie Chart
        const ctxPie = document.getElementById('statusPieChart').getContext('2d');
        new Chart(ctxPie, {
            type: 'pie',
            data: {
                labels: @Html.Raw(Model.StatusLabels),
                datasets: [{
                    data: @Html.Raw(Model.StatusData),
                    backgroundColor: @Html.Raw(Model.StatusColors),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>

    <script>
        $('#btn-chat').click(function () {
        var msg = $('#user-input').val();
        if (!msg) return;

        $('#chat-content').append(`<p><strong>Bạn:</strong> ${msg}</p>`);
        $('#user-input').val('');
        $('#chat-content').append(`<p id="ai-typing" class="text-muted small">AI đang suy nghĩ...</p>`);

        $.ajax({
            url: '@Url.Action("ChatWithAI", "DashBoard")',
            type: 'POST',
            data: { userMessage: msg },
            success: function (response) {
                $('#ai-typing').remove();
                $('#chat-content').append(`<p style="color: blue;"><strong>AI:</strong> ${response.reply}</p>`);
                // Tự động cuộn xuống dưới cùng
                $('#chat-content').scrollTop($('#chat-content')[0].scrollHeight);
            }
        });
    });
    </script>
}